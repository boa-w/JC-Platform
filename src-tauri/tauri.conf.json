{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "自定义开发平台",
  "version": "0.1.0",
  "identifier": "com.jc.custom-platform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "自定义开发平台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "JC",
    "homepage": "https://github.com/boa-w/JC-Platform",
    "copyright": "Copyright © 2026 JC. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "JC 配置项目桌面开发平台",
    "longDescription": "用于编辑、校验、版本审阅和导出 JC 配置项目的桌面工具。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkRERTUxNzdCN0U4NUYKUldSZjZMZDNVZDY5bG5CZGpwWHNkRzJFZUNKRWlPNlBpTXNrYTZ6eS9UdEtFK0FTbE15MW56Z1YK",
      "endpoints": [
        "https://github.com/boa-w/JC-Platform/releases/download/nightly/latest.json",
        "https://github.com/boa-w/JC-Platform/releases/latest/download/latest.json"
      ]
    }
  }
}

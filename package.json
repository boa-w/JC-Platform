{
  "name": "jc-custom-platform-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run version:check",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin jc-cli --",
    "cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin jc-cli --release",
    "version:check": "node scripts/check-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "format": "biome format --write .",
    "lint": "biome lint . --max-diagnostics=500",
    "lint:fix": "biome check --write .",
    "test:frontend": "node --test --experimental-strip-types tests/useStableCollectionKeys.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run lint && npm run test:frontend && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}

{
  "name": "jc-custom-platform-tauri",
  "private": true,
  "version": "0.1.0",
  "description": "面向 JC 配置项目的桌面编辑、校验、版本审阅与导出平台",
  "author": "JC",
  "homepage": "https://github.com/boa-w/JC-Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run version:check",
    "build": "tsc && vite build",
    "postbuild": "node scripts/check-frontend-bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin jc-cli --",
    "cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin jc-cli --release",
    "version:check": "node scripts/check-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release:check": "node scripts/check-release.mjs",
    "format": "biome format --write .",
    "lint": "biome lint . --max-diagnostics=500",
    "lint:fix": "biome check --write .",
    "test:frontend": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-installer.ps1",
    "test:bundle:macos": "bash scripts/test-macos-bundle.sh",
    "test:upgrade:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-upgrade.ps1",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run lint && npm run test:frontend && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
